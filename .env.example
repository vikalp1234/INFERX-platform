# INFERX local configuration template.
# Copy to `.env` (git-ignored) and fill in locally. Never commit real values.

INFERX_ENV=development
INFERX_LOG_LEVEL=INFO

# Approved model and pinned revision (verify the model card and license first).
INFERX_MODEL_ID=HuggingFaceTB/SmolLM2-360M-Instruct
INFERX_MODEL_REVISION=REPLACE_WITH_PINNED_REVISION

# Only needed for gated models. Placeholder, not a real token.
HF_TOKEN=REPLACE_WITH_YOUR_TOKEN_IF_NEEDED
